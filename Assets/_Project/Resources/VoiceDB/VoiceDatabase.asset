    clip: {fileID: 8300000, guid: 6d0956d8cc36f4d67a0c8e609a2c80d5, type: 3}
  - id: np_mee_01
    speaker: meera
    text: Be careful, sir.
    trigger: npc_near
    conditions: speaker=meera
    priority: 1
    cooldown: 60
    chance: 0.6
    once: 0
    subtitle: 1
