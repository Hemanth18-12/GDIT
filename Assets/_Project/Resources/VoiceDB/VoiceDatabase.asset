%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ad235ba6726444e7685186798f153ccb, type: 3}
  m_Name: VoiceDatabase
  m_EditorClassIdentifier: LOT.Core::LegacyOfTemples.Core.VoiceDatabase
  lines:
  - id: v3_mee_00
    speaker: meera
    text: Two men. One carried a bell.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 146a322f6c701460fa8f574f833f7d13, type: 3}
  - id: v3_mee_03
    speaker: meera
    text: It rang. He hid it fast.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 813560b1efe6945d3b119411792ab97d, type: 3}
  - id: v3_ary_06
    speaker: aryan
    text: He saw me. After him.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: a12e96008096a4390ac30a627e1ddd2b, type: 3}
  - id: v3_cou_01
    speaker: courier
    text: You followed me? Clever.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: e3de0ebc7c6034b9397adbc6b1686cc5, type: 3}
  - id: v3_ary_02
    speaker: aryan
    text: One. Four to go.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: e2207237f426f41f69af9d0fd6ed0abe, type: 3}
  - id: v3_ary_01
    speaker: aryan
    text: Not forced. Opened.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 24e4217d822734056a5878c6d71a5816, type: 3}
  - id: v3_ary_07
    speaker: aryan
    text: Two.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 08a6bc6be8de843729bc79f670dcde7c, type: 3}
  - id: v3_puj_03
    speaker: pujari
    text: The old vaults. Behind the temple.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 12a7a780626b84ac38a681c9507919c4, type: 3}
  - id: v3_ary_03
    speaker: aryan
    text: Three.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: d4461a2a019ca4053b63a91cd9575f2a, type: 3}
  - id: v3_mee_01
    speaker: meera
    text: They went to the old well. In this rain.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 224741bbc0a3d47c8921d39a57a3f703, type: 3}
  - id: v3_mee_02
    speaker: meera
    text: Only one man carries those keys.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 903a0df4f0e824b3680e7a81afcdfe5c, type: 3}
  - id: v3_ary_04
    speaker: aryan
    text: Four. Now the Sun Wall.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 28821b3894cbb44aa846873a12603f8b, type: 3}
  - id: v3_ary_05
    speaker: aryan
    text: An empty case. The jungle road.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 2e0803eb56416414fb70a20d053a665b, type: 3}
  - id: v3_mee_04
    speaker: meera
    text: Your jeep waits on the north road.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: a03b4239bfeac4e90a513ae42d80eb61, type: 3}
  - id: v3_bha_01
    speaker: bhaskar
    text: Keep moving. He is close.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 5b31019670ff34ac28166c67d1b4a8fe, type: 3}
  - id: v3_bha_02
    speaker: bhaskar
    text: Do you know what this fetches?
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 49958963b6acb48cf91ca918af1883db, type: 3}
  - id: v3_ary_08
    speaker: aryan
    text: Its value is not money.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: b8251185b7edb4ac8b9176e71f2e8b77, type: 3}
  - id: v3_mad_01
    speaker: madhav
    text: You knew?
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 9a2fe4a879fc442e0a29ea5c92ac68fd, type: 3}
  - id: v3_mad_02
    speaker: madhav
    text: I am sorry, sir.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 4bdd6d0c894f24454a72ad8481e23daf, type: 3}
  - id: v3_mad_03
    speaker: madhav
    text: I only opened a door.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: fe5e5ceec03a349f3b86f4ad56289b34, type: 3}
  - id: v3_ary_10
    speaker: aryan
    text: Five.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 49b51c7765b6b4b5e9571717bd8d71c3, type: 3}
  - id: v3_mad_04
    speaker: madhav
    text: Tea, sir? You look tired.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 4fa01f15d775145e0b55a81e1b119d1a, type: 3}
  - id: v3_mad_05
    speaker: madhav
    text: I locked up myself. As always.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 36de05c176bbd4997b7081aa6106a185, type: 3}
  - id: v3_mad_06
    speaker: madhav
    text: Take my lantern. It is dark below.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 71cb233790a1640b99eff5ccf6f5266f, type: 3}
  - id: v3_bha_03
    speaker: bhaskar
    text: Then come and take it.
    trigger: story
    conditions:
    priority: 4
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: a026dee16a9fc46588f4d22d4e2568b2, type: 3}
  - id: v3_puj_01
    speaker: pujari
    text: Five treasures. Gone before sunrise.
    trigger: story
    conditions:
    priority: 5
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 747795312fe8142e2988c9e93390cc25, type: 3}
  - id: v3_puj_02
    speaker: pujari
    text: The procession leaves at dawn.
    trigger: story
    conditions:
    priority: 5
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 0fad0d3860f7c4972bf2652d229f3db0, type: 3}
  - id: v3_puj_09
    speaker: pujari
    text: You brought our memory home.
    trigger: story
    conditions:
    priority: 5
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 2a205a603f6514303b69aeac67c891b0, type: 3}
  - id: v3_ary_09
    speaker: aryan
    text: Every piece is home.
    trigger: story
    conditions:
    priority: 5
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 00a2fadc4e6d34443ad61bf304bd9df2, type: 3}
  - id: intro_puj_01
    speaker: pujari
    text: Something terrible has happened!
    trigger: story
    conditions:
    priority: 5
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 93f0b95f933b74ef69438332e2440087, type: 3}
  - id: intro_ary_01
    speaker: aryan
    text: Excuse me, could you tell me the way to Jagannath Temple?
    trigger: story
    conditions:
    priority: 5
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 25561e0a39c134189a652041e78598d5, type: 3}
  - id: intro_mee_01
    speaker: meera
    text: Go straight along this road and follow the old stone entrance. The temple is at the end.
    trigger: story
    conditions:
    priority: 5
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 887701324167444b0a8af0d8a8c7169d, type: 3}
  - id: intro_ary_02
    speaker: aryan
    text: Thank you.
    trigger: story
    conditions:
    priority: 5
    cooldown: 0
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 2f84e570a43e9451fa1a0d5d38134c88, type: 3}
  - id: mv_first_01
    speaker: aryan
    text: Right. Let's find that temple.
    trigger: move_first
    conditions: objective=obj_c0_reach
    priority: 2
    cooldown: 0
    chance: 1
    once: 1
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: f61d3b74fc2bf43d38d9126fe5815e5b, type: 3}
  - id: mv_run_01
    speaker: aryan
    text: No time to stroll.
    trigger: run_long
    conditions: nofight;nojeep
    priority: 1
    cooldown: 75
    chance: 0.6
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: f408ef989978046368ab10bd5cf8d119, type: 3}
  - id: mv_run_02
    speaker: aryan
    text: Dawn won't wait.
    trigger: run_long
    conditions: nofight;nojeep
    priority: 1
    cooldown: 75
    chance: 0.6
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 236861644f70842eb96e3fdbe5cc9fa7, type: 3}
  - id: mv_tired_01
    speaker: aryan
    text: Need to catch my breath.
    trigger: run_tired
    conditions: nofight
    priority: 1
    cooldown: 180
    chance: 0.8
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 709faa3a5ff7e4dba859ba9c20626672, type: 3}
  - id: mv_tired_02
    speaker: aryan
    text: Easy. Breathe.
    trigger: run_tired
    conditions: nofight
    priority: 1
    cooldown: 180
    chance: 0.8
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: e87d8fdf95f704dadbefcb31e93fc1b4, type: 3}
  - id: mv_jump_01
    speaker: aryan
    text: Up we go.
    trigger: jump
    conditions: nofight
    priority: 1
    cooldown: 40
    chance: 0.2
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: a3dc6ca5a3e784c8a9cc9c9bf35f12ee, type: 3}
  - id: mv_land_01
    speaker: aryan
    text: Oof. Careful.
    trigger: land_hard
    conditions:
    priority: 1
    cooldown: 25
    chance: 0.8
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: c6e1e48afa6c84bae8237f6b4a794422, type: 3}
  - id: mv_land_02
    speaker: aryan
    text: That was a drop.
    trigger: land_hard
    conditions:
    priority: 1
    cooldown: 25
    chance: 0.8
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 4e16d52bcc9fe450fb2f4f22fc8ef5cf, type: 3}
  - id: mv_area_courtyard
    speaker: aryan
    text: The temple courtyard. Stay sharp.
    trigger: area_enter
    conditions: zone=Courtyard
    priority: 2
    cooldown: 5
    chance: 1
    once: 1
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 1e47eddd62960484b8520420b1c29cc6, type: 3}
  - id: mv_area_vaults
    speaker: aryan
    text: Dark down here. Watch your step.
    trigger: area_enter
    conditions: zone=Vaults
    priority: 2
    cooldown: 5
    chance: 1
    once: 1
    subtitle: 1
    fx: vault
    clip: {fileID: 8300000, guid: 51610f168890c46b787caa6ac3851f43, type: 3}
  - id: mv_area_stepwell
    speaker: aryan
    text: The old well. Listen to that rain.
    trigger: area_enter
    conditions: zone=Stepwell
    priority: 2
    cooldown: 5
    chance: 1
    once: 1
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 328bfcee486d843df997f9896c881bf2, type: 3}
  - id: mv_area_sunwall
    speaker: aryan
    text: No shade at all out here.
    trigger: area_enter
    conditions: zone=SunWall
    priority: 2
    cooldown: 5
    chance: 1
    once: 1
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: e2d20be9858a144ee8d6c660bbb6c534, type: 3}
  - id: mv_area_jungle
    speaker: aryan
    text: The river road. Trees everywhere.
    trigger: area_enter
    conditions: zone=Jungle
    priority: 2
    cooldown: 5
    chance: 1
    once: 1
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 4c49670d9535b4f6c8ad3212000f0d25, type: 3}
  - id: mv_area_bazaar
    speaker: aryan
    text: Back to the bazaar. Listen.
    trigger: area_enter
    conditions: zone=Bazaar;objective=obj_v3_bazaar
    priority: 2
    cooldown: 5
    chance: 1
    once: 1
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 643b20d90a484461f8dbe2c31387cda6, type: 3}
  - id: mv_danger_01
    speaker: aryan
    text: Careful. That's a long drop.
    trigger: danger_drop
    conditions: nofight;nojeep
    priority: 2
    cooldown: 120
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 1b88431699d8f4ac7a898b522aec2f86, type: 3}
  - id: mv_danger_02
    speaker: aryan
    text: One wrong step here...
    trigger: danger_drop
    conditions: nofight;nojeep
    priority: 2
    cooldown: 120
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: cbe31a0ad488844f1a6576480acf7c38, type: 3}
  - id: mv_rain_01
    speaker: aryan
    text: This rain won't stop.
    trigger: rain
    conditions: nofight
    priority: 1
    cooldown: 240
    chance: 0.6
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 5939696a958bd455c81641681ef1d0f8, type: 3}
  - id: mv_rain_02
    speaker: aryan
    text: Wet stone. Slippery.
    trigger: rain
    conditions: nofight
    priority: 1
    cooldown: 240
    chance: 0.6
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 3d277314adbf84e34a1ceedfa6b3bdaf, type: 3}
  - id: mv_lost_01
    speaker: aryan
    text: Think. Where would they go?
    trigger: lost
    conditions: nofight
    priority: 2
    cooldown: 150
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 6735f0afa67cb411889895d4455865e7, type: 3}
  - id: mv_lost_02
    speaker: aryan
    text: I'm losing time. My notes might help.
    trigger: lost
    conditions: nofight
    priority: 2
    cooldown: 150
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 074dbfaf7834841859606b3f20301a31, type: 3}
  - id: mv_lost_03
    speaker: aryan
    text: Retrace it. What did I miss?
    trigger: lost
    conditions: nofight
    priority: 2
    cooldown: 150
    chance: 1
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 1ba694389a5dc47239c119bd0b8f3157, type: 3}
  - id: mv_deadend_01
    speaker: aryan
    text: Dead end.
    trigger: dead_end
    conditions: nofight;nojeep
    priority: 1
    cooldown: 60
    chance: 0.7
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 6471bfd908d1b46919e723f32626bb03, type: 3}
  - id: jp_approach_01
    speaker: aryan
    text: The jeep. Still in one piece.
    trigger: jeep_approach
    conditions: nojeep;nofight
    priority: 1
    cooldown: 180
    chance: 0.5
    once: 0
    subtitle: 1
    fx: none
    clip: {fileID: 8300000, guid: 3960057dfc78740058e615667996660c, type: 3}
  - id: jp_enter_01
    speaker: aryan
    text: Let's go.
    trigger: jeep_enter
    conditions:
    priority: 2
    cooldown: 40
    chance: 1
    once: 0
    subtitle: 1
    fx: cabin
    clip: {fileID: 8300000, guid: fb85fa5b7c7004ce888072a8e7c580db, type: 3}
  - id: jp_enter_02
    speaker: aryan
    text: Right. Drive.
    trigger: jeep_enter
    conditions:
    priority: 2
    cooldown: 40
    chance: 1
    once: 0
    subtitle: 1
    fx: cabin
    clip: {fileID: 8300000, guid: 56b73c6e3b21446e4b455ef1fba84aef, type: 3}
  - id: jp_start_01
    speaker: aryan
    text: Good. She's running.
    trigger: jeep_start
    conditions: jeep
    priority: 1
    cooldown: 90
    chance: 0.5
    once: 0
    subtitle: 1
    fx: cabin
    clip: {fileID: 8300000, guid: 16ce49453140146f3985305ada69c6a9, type: 3}
  - id: jp_off_01
    speaker: aryan
    text: Here we go.
    trigger: jeep_drive_off
    conditions: jeep
    priority: 1
    cooldown: 90
    chance: 0.5
    once: 0
    subtitle: 1
    fx: cabin
    clip: {fileID: 8300000, guid: 358664762be2a4026bbc6a12a1d849ea, type: 3}
  - id: jp_fast_01
    speaker: aryan
    text: Faster. He's getting away.
    trigger: jeep_fast
    conditions: jeep;objective=obj_v3_jungle
    priority: 2
    cooldown: 45
    chance: 1
    once: 0
    subtitle: 1
    fx: cabin
    clip: {fileID: 8300000, guid: 0e0099905dd484bac837bc7a209bb208, type: 3}
  - id: jp_fast_02
    speaker: aryan
    text: Easy on this road.
    trigger: jeep_fast
    conditions: jeep;notobjective=obj_v3_jungle
    priority: 1
    cooldown: 60
    chance: 0.8
    once: 0
    subtitle: 1
    fx: cabin
    clip: {fileID: 8300000, guid: a097e2de3611848e0b7c47dc107401ab, type: 3}
  - id: jp_drift_01
    speaker: aryan
    text: Whoa, hold it!
    trigger: jeep_drift
    conditions: jeep
    priority: 2
    cooldown: 45
    chance: 1
    once: 0
    subtitle: 1
    fx: cabin
    clip: {fileID: 8300000, guid: 4a4dcd28c29b248b79e03e53d2d076a7, type: 3}
  - id: jp_brake_01
    speaker: aryan
    text: Brakes!
    trigger: jeep_handbrake
    conditions: jeep
    priority: 1
    cooldown: 45
    chance: 0.5
    once: 0
