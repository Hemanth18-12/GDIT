  m_EditorClassIdentifier: LOT.Gameplay::LegacyOfTemples.Gameplay.ClueInspectable
  clueId: clue_breached_case
  clueTitle: Breached Sacred Relic Chest
  clueCategory: Sanctum Vault Breach
  interactionRadius: 2.6
  clueDescription: 'An ancient cedar-wood chest lined with gold silk. The three custom velvet compartments are completely empty: The Sacred Pradip, The Sandstone Rosette, and The Tala Patra Manuscript have been stolen.'
  detectiveNote: The sacred Jagannath deity on the high altar was untouched in divine sanctity. Only these three portable historic treasures were targeted.
  inspectTransform: {fileID: 0}
  rotationSpeed: 90
  allow3DRotation: 1
  inspectSound: {fileID: 0}
