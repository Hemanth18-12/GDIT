  m_Name: 
  m_EditorClassIdentifier: LOT.Gameplay::LegacyOfTemples.Gameplay.ClueInspectable
  clueId: clue_muddy_footprints
  clueTitle: Red Clay Muddy Bootprints
  clueCategory: Escape Trail
  interactionRadius: 2.4
  clueDescription: Fresh boot impressions coated in wet reddish laterite soil, leading directly from the relic vault toward the southern corridor.
  detectiveNote: The red laterite clay only occurs along the outer shrine and jungle paths. The thieves fled directly toward the outer ruins.
  inspectTransform: {fileID: 0}
  rotationSpeed: 90
  allow3DRotation: 1
  inspectSound: {fileID: 0}
