  m_Name: 
  m_EditorClassIdentifier: LOT.Gameplay::LegacyOfTemples.Gameplay.ClueInspectable
  clueId: clue_broken_lock
  clueTitle: Broken Brass Sanctum Lock
  clueCategory: Sanctum Vault Breach
  interactionRadius: 2.2
  clueDescription: A heavy cast-brass sanctuary lock, cracked clean in two. The latch tongue shows sharp indentation marks from cold steel chisels, forced open with violent leverage.
  detectiveNote: The intruders came equipped with heavy iron masonry tools. This was not vandalism; it was an organized, targeted heist.
  inspectTransform: {fileID: 0}
  rotationSpeed: 90
  allow3DRotation: 1
  inspectSound: {fileID: 0}
