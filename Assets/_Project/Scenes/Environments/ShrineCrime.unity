  clueId: clue_fabric_fragment
  clueTitle: Torn Dark Cloak Thread
  clueCategory: Perpetrator Evidence
  interactionRadius: 2.5
  clueDescription: A shred of midnight-black woven wool caught on a sharp sandstone projection of the ruined plinth. Strong scent of burning torch pitch.
  detectiveNote: Matches the dark traveler cloaks worn by black-market antiquities smugglers. The thieves were running recklessly in the dark.
  inspectTransform: {fileID: 0}
  rotationSpeed: 90
  allow3DRotation: 1
  inspectSound: {fileID: 0}
